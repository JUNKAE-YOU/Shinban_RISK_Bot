# Supabase 프로젝트 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) 또는 기존 anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# 로그인 화면에 Google 로그인 버튼 표시 여부 (Supabase 에서 Google provider 를 켠 경우 true)
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
